# Copy to deploy/.env and replace both values. Never commit deploy/.env.
#   openssl rand -hex 24   -> POSTGRES_PASSWORD
#   openssl rand -hex 32   -> RELECTO_SECRET
POSTGRES_PASSWORD=change-me
RELECTO_SECRET=change-me
# 127.0.0.1 = this computer only. Set to 0.0.0.0 to let other PCs of the centre's network in
# (only behind the centre's firewall, and with HTTPS — see docs/DEPLOYMENT.md).
RELECTO_BIND=127.0.0.1
# Optional: only accept DICOM from these AE titles (comma-separated), e.g. CT_SCANNER1,PACS
RELECTO_DICOM_ALLOWED_AES=
